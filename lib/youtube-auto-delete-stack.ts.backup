import * as cdk from 'aws-cdk-lib'
import { Construct } from 'constructs'
import * as elasticache from 'aws-cdk-lib/aws-elasticache'
import * as ec2 from 'aws-cdk-lib/aws-ec2'
import * as ecs from 'aws-cdk-lib/aws-ecs'
import * as iam from 'aws-cdk-lib/aws-iam'
import * as logs from 'aws-cdk-lib/aws-logs'
import * as dynamodb from 'aws-cdk-lib/aws-dynamodb'
import * as elbv2 from 'aws-cdk-lib/aws-elasticloadbalancingv2'
import * as route53 from 'aws-cdk-lib/aws-route53'
import * as route53_targets from 'aws-cdk-lib/aws-route53-targets'
import * as acm from 'aws-cdk-lib/aws-certificatemanager'
import { prodEnv } from '../constants/prod-env'

export class YoutubeAutoDeleteStack extends cdk.Stack {
    constructor(scope: Construct, id: string, props?: cdk.StackProps) {
        super(scope, id, props)

        // Create a VPC for ElastiCache and ECS
        // Using 0 NAT Gateways to save costs (~$32/month)
        // Security maintained through security groups
        const vpc = new ec2.Vpc(this, 'YoutubeAutoDeleteVpc', {
            maxAzs: 2,
            natGateways: 0, // Cost optimization: Fargate in public subnets
        })

        // Create a security group for ElastiCache
        const cacheSecurityGroup = new ec2.SecurityGroup(
            this,
            'CacheSecurityGroup',
            {
                vpc,
                description: 'Security group for YouTube auto-delete cache',
                allowAllOutbound: true,
            }
        )

        // Allow inbound connections on Redis/Valkey port (6379)
        cacheSecurityGroup.addIngressRule(
            ec2.Peer.ipv4(vpc.vpcCidrBlock),
            ec2.Port.tcp(6379),
            'Allow Redis/Valkey connections from within VPC'
        )

        // Create serverless Valkey ElastiCache cache
        // Note: ElastiCache Serverless requires the VPC to be fully created first
        const serverlessCache = new elasticache.CfnServerlessCache(
            this,
            'YoutubeAutoDeleteCache',
            {
                engine: 'valkey',
                serverlessCacheName: 'youtube-auto-delete-cache',
                description:
                    'Serverless Valkey cache for YouTube auto-delete functionality',
                cacheUsageLimits: {
                    dataStorage: {
                        maximum: 5,
                        unit: 'GB',
                    },
                    ecpuPerSecond: {
                        maximum: 5000,
                    },
                },
                majorEngineVersion: '7',
                securityGroupIds: [cacheSecurityGroup.securityGroupId],
                subnetIds: vpc.privateSubnets.map((subnet) => subnet.subnetId),
            }
        )

        // Ensure VPC is created before ElastiCache
        serverlessCache.node.addDependency(vpc)

        // Create DynamoDB table
        const dynamoTable = new dynamodb.Table(this, 'YoutubeAutoDeleteDb', {
            tableName: 'youtube-auto-delete-db',
            partitionKey: {
                name: 'id',
                type: dynamodb.AttributeType.STRING,
            },
            billingMode: dynamodb.BillingMode.PAY_PER_REQUEST,
            removalPolicy: cdk.RemovalPolicy.RETAIN,
        })

        // Get environment variables from constants
        const envVars: { [key: string]: string } = { ...prodEnv }

        // Get Valkey endpoint and construct REDIS_URL
        const valkeyEndpoint = serverlessCache.attrEndpointAddress
        const valkeyPort = serverlessCache.attrEndpointPort || '6379'
        const redisUrl = `rediss://${valkeyEndpoint}:${valkeyPort}`
        envVars['REDIS_URL'] = redisUrl
        envVars['TABLE_NAME'] = dynamoTable.tableName

        // Create ECS Cluster
        const cluster = new ecs.Cluster(this, 'YoutubeAutoDeleteCluster', {
            vpc,
            clusterName: 'youtube-auto-delete-cluster',
        })

        // Create security group for ECS tasks
        const ecsSecurityGroup = new ec2.SecurityGroup(
            this,
            'EcsSecurityGroup',
            {
                vpc,
                description: 'Security group for ECS tasks',
                allowAllOutbound: true,
            }
        )

        // Create security group for Application Load Balancer
        const albSecurityGroup = new ec2.SecurityGroup(
            this,
            'AlbSecurityGroup',
            {
                vpc,
                description: 'Security group for Application Load Balancer',
                allowAllOutbound: true,
            }
        )

        // Allow HTTP traffic from internet to ALB
        albSecurityGroup.addIngressRule(
            ec2.Peer.anyIpv4(),
            ec2.Port.tcp(80),
            'Allow HTTP traffic from internet'
        )

        // Allow ECS tasks to connect to ElastiCache
        cacheSecurityGroup.addIngressRule(
            ecsSecurityGroup,
            ec2.Port.tcp(6379),
            'Allow ECS tasks to connect to cache'
        )

        // Allow ALB to connect to ECS tasks
        ecsSecurityGroup.addIngressRule(
            albSecurityGroup,
            ec2.Port.tcp(80),
            'Allow ALB to connect to ECS tasks'
        )

        // Create Fargate task definition
        const taskDefinition = new ecs.FargateTaskDefinition(
            this,
            'YoutubeAutoDeleteTask',
            {
                memoryLimitMiB: 512,
                cpu: 256,
            }
        )

        // Grant DynamoDB permissions to the task role
        dynamoTable.grantReadWriteData(taskDefinition.taskRole)

        // Grant ECR permissions to pull container image
        taskDefinition.taskRole.addToPrincipalPolicy(
            new iam.PolicyStatement({
                effect: iam.Effect.ALLOW,
                actions: [
                    'ecr:GetAuthorizationToken',
                    'ecr:BatchCheckLayerAvailability',
                    'ecr:GetDownloadUrlForLayer',
                    'ecr:BatchGetImage',
                ],
                resources: ['*'],
            })
        )

        // Add container with environment variables from prod.env
        const container = taskDefinition.addContainer('AppContainer', {
            image: ecs.ContainerImage.fromRegistry(
                '954573579519.dkr.ecr.us-east-1.amazonaws.com/main:latest'
            ), // Placeholder - replace with your image
            logging: ecs.LogDriver.awsLogs({
                streamPrefix: 'youtube-auto-delete',
                logGroup: new logs.LogGroup(this, 'YoutubeAutoDeleteLogGroup', {
                    logGroupName: '/ecs/youtube-auto-delete',
                    retention: logs.RetentionDays.ONE_WEEK,
                }),
            }),
            environment: envVars,
        })

        // Add port mapping
        container.addPortMappings({
            containerPort: 80,
            protocol: ecs.Protocol.TCP,
        })

        // Create Application Load Balancer
        const loadBalancer = new elbv2.ApplicationLoadBalancer(
            this,
            'YoutubeAutoDeleteAlb',
            {
                vpc,
                internetFacing: true,
                securityGroup: albSecurityGroup,
                vpcSubnets: {
                    subnets: vpc.publicSubnets,
                },
            }
        )

        // Create target group
        const targetGroup = new elbv2.ApplicationTargetGroup(
            this,
            'YoutubeAutoDeleteTargetGroup',
            {
                vpc,
                port: 80,
                protocol: elbv2.ApplicationProtocol.HTTP,
                targetType: elbv2.TargetType.IP,
                healthCheck: {
                    enabled: true,
                    path: '/',
                    healthyHttpCodes: '200',
                    interval: cdk.Duration.seconds(30),
                    timeout: cdk.Duration.seconds(5),
                    healthyThresholdCount: 2,
                    unhealthyThresholdCount: 3,
                },
            }
        )

        // Use existing hosted zone for youtube-auto-delete.com
        const hostedZone = route53.HostedZone.fromHostedZoneAttributes(
            this,
            'YoutubeAutoDeleteHostedZone',
            {
                hostedZoneId: 'Z0595886CSWS83B9S39P',
                zoneName: 'youtube-auto-delete.com',
            }
        )

        // Create SSL certificate for api.youtube-auto-delete.com
        // Using DNS validation which will create CNAME records automatically
        const certificate = new acm.Certificate(
            this,
            'YoutubeAutoDeleteCertificate',
            {
                domainName: 'api.youtube-auto-delete.com',
                validation: acm.CertificateValidation.fromDns(hostedZone),
            }
        )

        // Ensure hosted zone exists before certificate validation
        certificate.node.addDependency(hostedZone)

        // Create HTTPS listener on port 443
        // Certificate validation will happen asynchronously via DNS
        const httpsListener = loadBalancer.addListener('HttpsListener', {
            port: 443,
            protocol: elbv2.ApplicationProtocol.HTTPS,
            certificates: [certificate],
            defaultTargetGroups: [targetGroup],
        })

        // Ensure certificate is created before listener
        httpsListener.node.addDependency(certificate)

        // Create HTTP listener that redirects to HTTPS
        loadBalancer.addListener('HttpListener', {
            port: 80,
            protocol: elbv2.ApplicationProtocol.HTTP,
            defaultAction: elbv2.ListenerAction.redirect({
                protocol: 'HTTPS',
                port: '443',
                permanent: true,
            }),
        })

        // Create Route53 A record pointing to the load balancer
        new route53.ARecord(this, 'YoutubeAutoDeleteApiRecord', {
            zone: hostedZone,
            recordName: 'api',
            target: route53.RecordTarget.fromAlias(
                new route53_targets.LoadBalancerTarget(loadBalancer)
            ),
        })

        // Create Fargate service (running one task)
        // Using public subnets to avoid NAT Gateway costs
        // Security maintained: ECS tasks only accept traffic from ALB (via security group)
        const fargateService = new ecs.FargateService(
            this,
            'YoutubeAutoDeleteService',
            {
                cluster,
                taskDefinition,
                desiredCount: 1,
                securityGroups: [ecsSecurityGroup],
                vpcSubnets: {
                    subnets: vpc.publicSubnets, // Public subnets to avoid NAT Gateway
                },
            }
        )

        // Attach service to target group
        fargateService.attachToApplicationTargetGroup(targetGroup)

        // Export the API URL
        new cdk.CfnOutput(this, 'ApiUrl', {
            value: 'https://api.youtube-auto-delete.com',
            description: 'URL of the API endpoint',
        })

        // Export the load balancer DNS name (for reference)
        new cdk.CfnOutput(this, 'LoadBalancerDns', {
            value: loadBalancer.loadBalancerDnsName,
            description: 'DNS name of the Application Load Balancer',
        })
    }
}
